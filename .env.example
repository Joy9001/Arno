# Copy to .env and set every value. `.env` is gitignored; secrets never go in the database.

# The pinned release image tag. Compose uses this for the API and backup images.
FIN_AGENT_VERSION=0.1.0
# Host ports. Change them if 5433 or 8000 is taken.
# FIN_AGENT_DB_PORT=5433
# FIN_AGENT_API_PORT=8000
# The Compose services read this env file. Leave it alone unless a clean-room check needs another.
# FIN_AGENT_ENV_FILE=.env

# Postgres. Use long random values.
POSTGRES_PASSWORD=change-me
AGENT_RO_PASSWORD=change-me-too
# The backup sidecar's own role. The API sets its password at boot.
BACKUP_PASSWORD=change-me-three

# Off-site backup. RESTIC_PASSWORD is the one secret that must live somewhere other than this
# machine: losing it makes the off-site copies unreadable. Store it off-machine.
RESTIC_PASSWORD=change-me-four
# Default is a local Docker volume (`backup-data`), which is not off-site. For off-site, use Google
# Drive through rclone, or S3-compatible storage (Cloudflare R2, AWS S3, Backblaze B2); both need
# only these variables.
RESTIC_REPOSITORY=/backups/restic
#
# Google Drive, the current recommended setup, with your own Google OAuth client (Desktop app).
# Get the token with `rclone authorize "drive" <base64 blob>`; see self-hosting.md section 6.1.
# The client secret and refresh token are credentials: keep them out of git.
# RESTIC_REPOSITORY=rclone:gdrive:fin-agent-backups
# RCLONE_CONFIG_GDRIVE_TYPE=drive
# RCLONE_CONFIG_GDRIVE_SCOPE=drive.file
# RCLONE_CONFIG_GDRIVE_CLIENT_ID=<client id>
# RCLONE_CONFIG_GDRIVE_CLIENT_SECRET=<client secret>
# RCLONE_CONFIG_GDRIVE_TOKEN='{"access_token":"...","token_type":"Bearer","refresh_token":"...","expiry":"..."}'
#
# Cloudflare R2: create an API token scoped to Object Read & Write on that bucket only. Other
# rclone remotes work through RCLONE_CONFIG_<NAME>_* variables. SFTP does not work: no ssh client.
# RESTIC_REPOSITORY=s3:https://<account-id>.r2.cloudflarestorage.com/<bucket>
# AWS_ACCESS_KEY_ID=<R2 API token access key id>
# AWS_SECRET_ACCESS_KEY=<R2 API token secret>
# AWS_DEFAULT_REGION=auto
# BACKUP_INTERVAL_SECONDS=3600
# BACKUP_MAX_AGE_SECONDS=86400

# A plain pg_dump written before a pending migration. In Compose this is the
# `pre-migration-data` volume; on the host it defaults to the system temp directory.
# FIN_AGENT_PRE_MIGRATION_DIR=/app/pre-migration

# The hostname passkeys are bound to, and the origin you open in the browser.
# Development (http://localhost:8000 works without Tailscale):
FIN_AGENT_RP_ID=localhost
FIN_AGENT_RP_ORIGIN=http://localhost:8000

# Production over Tailscale: use the machine's tailnet name. `tailscale serve` gives it HTTPS.
# FIN_AGENT_RP_ID=my-mini-pc.tailnet-name.ts.net
# FIN_AGENT_RP_ORIGIN=https://my-mini-pc.tailnet-name.ts.net

# Host header allowlist. The default also accepts any *.ts.net name.
FIN_AGENT_TRUSTED_HOSTS=localhost,127.0.0.1,*.ts.net

# Opaque session lifetime, setup-token lifetime, and Secure cookies.
FIN_AGENT_SESSION_TTL_DAYS=30
FIN_AGENT_SETUP_TOKEN_TTL_HOURS=24
# Defaults to on when FIN_AGENT_RP_ORIGIN is https://; leave it alone in production.
# FIN_AGENT_COOKIE_SECURE=1

# The jobs loop runs in the API process. Set to 0 for a read-only web process or tests.
# FIN_AGENT_JOBS_ENABLED=1

# Web push VAPID contact. Keys are generated once on the first run; only this subject is
# configured here. Use a mailto: address or an https: URL.
# FIN_AGENT_VAPID_SUBJECT=mailto:fin-agent@localhost

# Key for the one-way hashes of third-party account numbers in narrations. Set a long random
# value; changing it makes old statement lines stop matching new ones.
# FIN_AGENT_MATCH_KEY=change-me-six

# Host-side development only (the API service overrides this to reach `db`).
DATABASE_URL=postgresql://app:change-me@127.0.0.1:5433/fin_agent

# Model roles. OpenCode Go is the primary; free Cohere is the fallback.
# OpenCode Go (paid; DeepSeek V4.1 Flash, zero retention):
CHAT_BASE_URL=https://opencode.ai/inference/go/openai/v1
CHAT_API_KEY=<OpenCode Go personal key>
CHAT_MODEL=deepseek-v4.1-flash
LLM_CONTEXT_WINDOW=1000000
# Optional: a stable OpenCode routing/cache session. Defaults to one per process.
# OPENCODE_SESSION_ID=fin-agent-local

# Optional free fallback, off by default. Only for synthetic runs; a free provider may
# train on or retain prompts, so leave it off when working with real statements.
# CHAT_FALLBACK_BASE_URL=https://api.cohere.ai/compatibility/v1
# CHAT_FALLBACK_API_KEY=<Cohere trial key>
# CHAT_FALLBACK_MODEL=command-a-plus-05-2026
# CHAT_FALLBACK_CONTEXT_WINDOW=128000

# Local Ollama alternative (host or Compose):
# CHAT_BASE_URL=http://127.0.0.1:11434/v1
# CHAT_API_KEY=ollama
# CHAT_MODEL=qwen3:4b
# LLM_CONTEXT_WINDOW=128000

# Vision and speech-to-text roles. VISION reads pages with no text layer at import;
# speech-to-text is L7's voice-note path.
VISION_BASE_URL=
VISION_MODEL=
# Local: `docker compose --profile local-stt up -d`, then these two values. The API container
# reaches the service as `speaches`; from the host it is http://127.0.0.1:8001/v1.
# STT_BASE_URL=http://speaches:8000/v1
# STT_MODEL=Systran/faster-whisper-small
# STT_API_KEY=not-needed
# A cloud OpenAI-compatible transcription endpoint also works. The optional prompt carries active
# payee names: with a cloud endpoint, those names leave the box too. Set to 0 to turn it off.
# STT_PAYEE_CONTEXT=1
STT_BASE_URL=
STT_MODEL=

# OpenAI-compatible free endpoints tested with the synthetic demo persona at L2.
# Free tiers may train on or retain prompts: use these for development, not real money data.
# Cohere:   CHAT_BASE_URL=https://api.cohere.ai/compatibility/v1
#           CHAT_MODEL=command-a-plus-05-2026
# Gonka:    CHAT_BASE_URL=https://proxy.gonkabroker.com/v1
#           CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
# Groq:     CHAT_BASE_URL=https://api.groq.com/openai/v1
#           CHAT_MODEL=openai/gpt-oss-20b        # keep the snapshot small: free TPM is 8k
# Mistral:  CHAT_BASE_URL=https://api.mistral.ai/v1
#           CHAT_MODEL=ministral-14b-latest
# NVIDIA:   CHAT_BASE_URL=https://integrate.api.nvidia.com/v1
#           CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Kilo:     CHAT_BASE_URL=https://api.kilo.ai/api/gateway
#           CHAT_MODEL=kilo-auto/free

# Native Pydantic AI traces export directly to Phoenix over OTLP/HTTP. There is no Collector,
# Loki, Prometheus, or Grafana. Application logs stay standard Python/Uvicorn stdout in Docker.
# In Compose, use the service name; a host CLI or eval uses http://127.0.0.1:6006/v1/traces.
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006/v1/traces
PHOENIX_PROJECT_NAME=fin-agent
# This authenticated Compose Phoenix uses PHOENIX_ADMIN_SECRET as the local bearer credential by
# default, so a normal start needs no key creation or second restart. Set PHOENIX_API_KEY only to
# use a real Phoenix API key instead.
# PHOENIX_API_KEY=
# Standard OpenTelemetry SDK kill switch. `true` registers no exporter and instruments no agent;
# the app still serves. There is no other tracing switch.
OTEL_SDK_DISABLED=false
PHOENIX_UI_PORT=6006

# Do not commit real secrets. Generate each value on the host, for example:
#   openssl rand -hex 32
# An empty Phoenix value keeps Phoenix down; the app and its database still run.
# Phoenix requires auth because its container binds ::. UI and ingest stay loopback-only.
PHOENIX_SECRET=
# Also the default local bearer credential for trace export; set PHOENIX_API_KEY to override.
PHOENIX_ADMIN_SECRET=
PHOENIX_DEFAULT_ADMIN_INITIAL_PASSWORD=
PHOENIX_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:6006
# The Phoenix database role. Independent of the UI auth secrets above.
PHOENIX_PASSWORD=change-me-five
# Phoenix keeps its own retention default; no custom retention is configured here.

# Local-only HackerRank "Buy or Wait" sample dataset. It has no license and is never committed.
# FIN_AGENT_HACKERRANK_DATASET=private/hackerrank-orchestrate-september26/dataset
