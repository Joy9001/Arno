# Copy to .env and set every value. `.env` is gitignored; secrets never go in the database.

# Postgres. Use long random values.
POSTGRES_PASSWORD=change-me
AGENT_RO_PASSWORD=change-me-too
# The backup sidecar's own role. The API sets its password at boot.
BACKUP_PASSWORD=change-me-three

# Off-site backup. RESTIC_PASSWORD is the one secret that must live somewhere other than this
# machine: losing it makes the off-site copies unreadable.
RESTIC_PASSWORD=change-me-four
# Default is a local Docker volume (`backup-data`). Use S3/B2/R2 or an rclone remote here.
RESTIC_REPOSITORY=/backups/restic
# BACKUP_INTERVAL_SECONDS=3600
# BACKUP_MAX_AGE_SECONDS=86400

# The hostname passkeys are bound to, and the origin you open in the browser.
# Development (http://localhost:8000 works without Tailscale):
FIN_AGENT_RP_ID=localhost
FIN_AGENT_RP_ORIGIN=http://localhost:8000

# Production over Tailscale: use the machine's tailnet name. `tailscale serve` gives it HTTPS.
# FIN_AGENT_RP_ID=my-mini-pc.tailnet-name.ts.net
# FIN_AGENT_RP_ORIGIN=https://my-mini-pc.tailnet-name.ts.net

# Host header allowlist. The default also accepts any *.ts.net name.
FIN_AGENT_TRUSTED_HOSTS=localhost,127.0.0.1,*.ts.net

# Opaque session lifetime, setup-token lifetime, and Secure cookies.
FIN_AGENT_SESSION_TTL_DAYS=30
FIN_AGENT_SETUP_TOKEN_TTL_HOURS=24
# Defaults to on when FIN_AGENT_RP_ORIGIN is https://; leave it alone in production.
# FIN_AGENT_COOKIE_SECURE=1

# Host-side development only (the API service overrides this to reach `db`).
DATABASE_URL=postgresql://app:change-me@127.0.0.1:5433/fin_agent

# Model roles. Local and cloud take the same OpenAI-compatible path.
# Local Ollama (`docker compose --profile local-llm up`):
#   On the host, use http://127.0.0.1:11434/v1.
#   Inside Compose, use http://ollama:11434/v1.
CHAT_BASE_URL=http://127.0.0.1:11434/v1
CHAT_API_KEY=ollama
CHAT_MODEL=qwen3:4b
# Cloud:
# CHAT_BASE_URL=https://api.openai.com/v1
# CHAT_API_KEY=sk-...
# CHAT_MODEL=gpt-5.4-2026-06-01
# An optional backup, used when the main endpoint errors or hangs.
# CHAT_FALLBACK_BASE_URL=http://127.0.0.1:11434/v1
# CHAT_FALLBACK_MODEL=qwen3:4b
# CHAT_FALLBACK_CONTEXT_WINDOW=32768
# Must match what the server really uses (Ollama's OLLAMA_CONTEXT_LENGTH).
# LLM_CONTEXT_WINDOW=128000
# Vision and speech-to-text roles land with L7.
VISION_BASE_URL=
VISION_MODEL=
STT_BASE_URL=
STT_MODEL=

# `docker compose --profile traces up` adds Phoenix. Point the API at it:
# PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_PASSWORD=change-me-five
# Optional: the harness's spend store uses its own asyncpg pool on DATABASE_URL.
