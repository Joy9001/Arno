# Copy to .env and set every value. `.env` is gitignored; secrets never go in the database.

# The pinned release image tag. Compose uses this for the API image.
ARNO_VERSION=0.4.2
# Host ports. Change them if 5433 or 8000 is taken. Phoenix's UI port is set further down.
# ARNO_DB_PORT=5433
# ARNO_API_PORT=8000
# A second stack on one host also needs its own project name, since compose.yaml pins
# `name: arno`. Set it here or with `docker compose -p <name>`.
# COMPOSE_PROJECT_NAME=arno
# The Compose services read this env file. Leave it alone unless a clean-room check needs another.
# ARNO_ENV_FILE=.env

# Postgres. Use long random values. Generate them as hex (`openssl rand -hex 32`): these three
# land inside DATABASE_URL, where a `/` or `+` from a base64 string breaks the URI.
# POSTGRES_PASSWORD is the password for `app` (the non-superuser database owner); the `postgres`
# bootstrap superuser has no network password and is reachable only on the container's socket.
POSTGRES_PASSWORD=change-me
AGENT_RO_PASSWORD=change-me-too
# The backup database role. The API sets its password at boot.
BACKUP_PASSWORD=change-me-three

# Off-site backup. RESTIC_PASSWORD is the one secret that must live somewhere other than this
# machine: losing it makes the off-site copies unreadable. Store it off-machine.
RESTIC_PASSWORD=change-me-four
# Default is a local Docker volume (`backup-data`), which is not off-site. For off-site, use Google
# Drive through rclone, or S3-compatible storage (Cloudflare R2, AWS S3, Backblaze B2); both need
# only these variables.
RESTIC_REPOSITORY=/backups/restic
#
# Google Drive, the current recommended setup, with your own Google OAuth client (Desktop app).
# Get the token with `rclone authorize "drive" <base64 blob>`; see docs/arno/operations/self-hosting.md.
# The client secret and refresh token are credentials: keep them out of git.
# RESTIC_REPOSITORY=rclone:gdrive:arno-backups
# RCLONE_CONFIG_GDRIVE_TYPE=drive
# RCLONE_CONFIG_GDRIVE_SCOPE=drive.file
# RCLONE_CONFIG_GDRIVE_CLIENT_ID=<client id>
# RCLONE_CONFIG_GDRIVE_CLIENT_SECRET=<client secret>
# RCLONE_CONFIG_GDRIVE_TOKEN='{"access_token":"...","token_type":"Bearer","refresh_token":"...","expiry":"..."}'
#
# Cloudflare R2: create an API token scoped to Object Read & Write on that bucket only. Other
# rclone remotes work through RCLONE_CONFIG_<NAME>_* variables. SFTP does not work: no ssh client.
# RESTIC_REPOSITORY=s3:https://<account-id>.r2.cloudflarestorage.com/<bucket>
# AWS_ACCESS_KEY_ID=<R2 API token access key id>
# AWS_SECRET_ACCESS_KEY=<R2 API token secret>
# AWS_DEFAULT_REGION=auto

# A plain pg_dump written before a pending migration. In Compose this is the
# `pre-migration-data` volume; on the host it defaults to the system temp directory.
# ARNO_PRE_MIGRATION_DIR=/app/pre-migration

# The hostname passkeys are bound to, and the origin you open in the browser.
# Development (http://localhost:8000 works without Tailscale):
ARNO_RP_ID=localhost
ARNO_RP_ORIGIN=http://localhost:8000

# Production over Tailscale: use the machine's tailnet name. `tailscale serve` gives it HTTPS.
# ARNO_RP_ID=my-mini-pc.tailnet-name.ts.net
# ARNO_RP_ORIGIN=https://my-mini-pc.tailnet-name.ts.net

# Host header allowlist. The default also accepts any *.ts.net name.
ARNO_TRUSTED_HOSTS=localhost,127.0.0.1,*.ts.net

# Opaque session lifetime, setup-token lifetime, and Secure cookies.
ARNO_SESSION_TTL_DAYS=30
ARNO_SETUP_TOKEN_TTL_HOURS=24
# Defaults to on when ARNO_RP_ORIGIN is https://; leave it alone in production.
# ARNO_COOKIE_SECURE=1

# The jobs loop runs in the API process. Set to 0 for a read-only web process or tests.
# ARNO_JOBS_ENABLED=1

# Web push VAPID contact. Keys are generated once on the first run; only this subject is
# configured here. Use a mailto: address or an https: URL.
# ARNO_VAPID_SUBJECT=mailto:arno@localhost

# Key for the one-way hashes of third-party account numbers in narrations. Set a long random
# value; changing it makes old statement lines stop matching new ones.
# ARNO_MATCH_KEY=change-me-six

# Host-side development only (the API service overrides this to reach `db`).
DATABASE_URL=postgresql://app:change-me@127.0.0.1:5433/arno

# Model roles. OpenCode Go is the primary; free Cohere is the fallback.
# OpenCode Go (paid; DeepSeek V4.1 Flash, zero retention):
CHAT_BASE_URL=https://opencode.ai/inference/go/openai/v1
CHAT_API_KEY=<OpenCode Go personal key>
CHAT_MODEL=deepseek-v4.1-flash
# Model usage is logged to Postgres and capped at $20 a day for the whole instance. Models the
# price catalog does not know (OpenCode Go models, for one) count as $0 toward that cap.
LLM_CONTEXT_WINDOW=1000000

# Native Anthropic Messages adapter. Leave CHAT_BASE_URL unset for the default endpoint.
# A Console API key works normally; eligible plan credits use this same API route.
# CHAT_PROVIDER=anthropic
# CHAT_API_KEY=<Console API key>
# CHAT_MODEL=<exact Claude model id>
# LLM_CONTEXT_WINDOW=200000

# Optional free fallback, off by default. Only for synthetic runs; a free provider may
# train on or retain prompts, so leave it off when working with real statements.
# CHAT_FALLBACK_BASE_URL=https://api.cohere.ai/compatibility/v1
# CHAT_FALLBACK_API_KEY=<Cohere trial key>
# CHAT_FALLBACK_MODEL=command-a-plus-05-2026
# CHAT_FALLBACK_CONTEXT_WINDOW=128000

# Local Ollama alternative (host or Compose):
# CHAT_BASE_URL=http://127.0.0.1:11434/v1
# CHAT_API_KEY=ollama
# CHAT_MODEL=qwen3:4b
# CHAT_PROVIDER=ollama
# LLM_CONTEXT_WINDOW=128000

# Vision and speech-to-text roles. VISION reads pages with no text layer at import;
# speech-to-text is L7's voice-note path.
VISION_BASE_URL=
VISION_MODEL=
# VISION_PROVIDER=openai
# Optional parser subagent model. Leave unset to use the chat model.
# PARSE_BASE_URL=
# PARSE_API_KEY=
# PARSE_MODEL=
# PARSE_PROVIDER=openai
# An OpenAI-compatible transcription endpoint (cloud or self-hosted) works:
# STT_API_KEY=<key>
# STT_PROVIDER=openai
# The optional prompt carries active
# payee names: with a cloud endpoint, those names leave the box too. Set to 0 to turn it off.
# STT_PAYEE_CONTEXT=1
# Pin the spoken language. Short clips are often auto-detected wrong (a "Hello" came back as
# Japanese). `en` also suits Hinglish written in Latin script; unset to auto-detect.
# STT_LANGUAGE=en
STT_BASE_URL=
STT_MODEL=

# The code sandbox behind the agent's run_python tool. Compose sets this to the sandbox service.
# For `uv run arno serve` on the host, run the sandbox container and point at its published port.
# ARNO_SANDBOX_URL=http://sandbox:8001

# Web search. A model with built-in search uses it. Any other model searches through Brave Search
# when this key is set, and has no web search when it is not. Queries never carry your balances,
# account numbers, or payees. https://brave.com/search/api/
# BRAVE_API_KEY=<key>

# OpenAI-compatible free endpoints tested with the synthetic demo persona at L2.
# Free tiers may train on or retain prompts: use these for development, not real money data.
# Cohere:   CHAT_BASE_URL=https://api.cohere.ai/compatibility/v1
#           CHAT_MODEL=command-a-plus-05-2026
# Gonka:    CHAT_BASE_URL=https://proxy.gonkabroker.com/v1
#           CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
# Groq:     CHAT_BASE_URL=https://api.groq.com/openai/v1
#           CHAT_MODEL=openai/gpt-oss-20b        # keep the snapshot small: free TPM is 8k
# Mistral:  CHAT_BASE_URL=https://api.mistral.ai/v1
#           CHAT_MODEL=ministral-14b-latest
# NVIDIA:   CHAT_BASE_URL=https://integrate.api.nvidia.com/v1
#           CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Kilo:     CHAT_BASE_URL=https://api.kilo.ai/api/gateway
#           CHAT_MODEL=kilo-auto/free

# Traces export to Phoenix over OTLP/HTTP with the stock OpenTelemetry SDK:
# FastAPI requests, asyncpg queries, and Pydantic AI runs. There is no Collector, Loki,
# Prometheus, or Grafana. Application logs stay standard Python/Uvicorn stdout in Docker.
# Operations: docs/arno/operations/observability.md. Costs: docs/arno/specs/cost-tracking.md.
# Tracing is opt-in: with the endpoint unset, nothing is registered or instrumented. To turn it
# on, set the Phoenix secrets below, set the endpoint (the base URL; the exporter appends
# /v1/traces), and start Phoenix with `docker compose --profile obs up -d`. A host CLI uses
# http://127.0.0.1:6006.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://phoenix:6006
# Compose sends PHOENIX_ADMIN_SECRET as the bearer token. Set this only to override it, for
# example with a real Phoenix API key.
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20<key>
# Standard OpenTelemetry SDK kill switch. `true` registers no exporter and instruments nothing;
# the app still serves.
OTEL_SDK_DISABLED=false
# Phoenix's UI port on the host's loopback. Change it if 6006 is taken.
PHOENIX_UI_PORT=6006

# Do not commit real secrets. Generate each value on the host, for example:
#   openssl rand -hex 32
# Phoenix (`--profile obs`) needs the three values below. They ship empty on purpose: a
# placeholder that Phoenix accepts would be a credential everyone knows.
# Phoenix requires auth because its container binds ::. UI and ingest stay loopback-only.
PHOENIX_SECRET=
# Also the default local bearer credential for trace export (override: OTEL_EXPORTER_OTLP_HEADERS).
# 32+ characters, with a digit and a lowercase letter.
PHOENIX_ADMIN_SECRET=
PHOENIX_DEFAULT_ADMIN_INITIAL_PASSWORD=
PHOENIX_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:6006
# Phoenix keeps its own retention default; no custom retention is configured here.

