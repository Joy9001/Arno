digraph hybrid {
  graph [rankdir=TB, fontname="Helvetica", bgcolor=white, label="Hybrid retrieval pipeline: indexing time vs query time", labelloc=t, fontsize=16, nodesep=0.35, ranksep=0.45, pad=0.2, newrank=true]
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, penwidth=1.5, color="#16A34A", fillcolor="#DCFCE7", margin="0.12,0.07"]
  edge [color="#555555", fontname="Helvetica", fontsize=11, penwidth=1.3]

  subgraph cluster_index {
    label="Indexing time (once per document; re-run on document change)"; style="rounded,dashed"; color="#6B7280"; fontsize=13; fontname="Helvetica-Bold"
    docs [label="documents"]
    chunk [label="split into chunks"]
    ctx [label="LLM writes situating context\nper chunk, prepended to it\n(contextual chunks)", color="#2563EB", fillcolor="#DBEAFE"]
    emb [label="embed contextual chunks\n(contextual embeddings)", color="#2563EB", fillcolor="#DBEAFE"]
    bm [label="build BM25 index over\ncontextual chunks"]
    vidx [label="vector index", shape=cylinder, color="#6B7280", fillcolor="#F3F4F6"]
    bidx [label="BM25 index", shape=cylinder, color="#6B7280", fillcolor="#F3F4F6"]
    docs -> chunk -> ctx
    ctx -> bm; ctx -> emb
    bm -> bidx; emb -> vidx
    {rank=same; emb; bm}
  }

  subgraph cluster_query {
    label="Query time"; style="rounded,dashed"; color="#6B7280"; fontsize=13; fontname="Helvetica-Bold"
    q [label="user query"]
    sb [label="BM25 search"]
    sd [label="dense (embedding) search"]
    fuse [label="rank fusion"]
    rr [label="rerank\n(cross-encoder, Cohere)"]
    top [label="top-20 chunks\ninto the prompt"]
    gen [label="generate answer", color="#2563EB", fillcolor="#DBEAFE"]
    q -> sd; q -> sb
    sd -> fuse; sb -> fuse
    {rank=same; sd; sb}
    sd -> sb [style=invis]
    fuse -> rr [label="  top 150 chunks"]
    rr -> top -> gen
  }
  vidx -> q [style=invis]
  bidx -> q [style=invis]
  vidx -> sd [label="  looks up", style=dashed]
  bidx -> sb [label="  looks up", style=dashed]

  note [shape=note, color="#6B7280", fillcolor="#F9FAFB", fontsize=11, label="Top-20 retrieval failure rate (Anthropic's test sets):\l  baseline embeddings 5.7%\l  + contextual embeddings 3.7%\l  + contextual BM25 2.9%\l  + rerank 1.9% (-67% overall)\l"]
  gen -> note [style=invis]
}
