digraph G {
  graph [rankdir=TB, fontname="Helvetica", bgcolor=white, label="Anthropic's five workflow patterns\n(blue = LLM call, green = deterministic code)", labelloc=t, fontsize=16, nodesep=0.12, ranksep=0.3, pad=0.15, compound=true]
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin="0.08,0.05", width=0.9]
  edge [color="#555555", fontname="Helvetica", fontsize=9, arrowsize=0.6]
  node [fillcolor="#DBEAFE", color="#2563EB"]

  subgraph cluster_a { label="Prompt chaining"; fontsize=12; style="rounded"; color="#9CA3AF"
    a0 [label="Input", fillcolor="white", color="#6B7280"]
    a1 [label="LLM call 1"]
    a2 [label="Gate\n(code check)", fillcolor="#DCFCE7", color="#16A34A"]
    a3 [label="LLM call 2"]
    a4 [label="Output", fillcolor="white", color="#6B7280"]
    a0->a1->a2; a2->a3 [label="pass"]; a3->a4
  }
  subgraph cluster_b { label="Routing"; fontsize=12; style="rounded"; color="#9CA3AF"
    b0 [label="Input", fillcolor="white", color="#6B7280"]
    b1 [label="LLM\nclassifies"]
    b2 [label="Handler A\n(e.g. small model)", fillcolor="#DCFCE7", color="#16A34A"]
    b3 [label="Handler B", fillcolor="#DCFCE7", color="#16A34A"]
    b0->b1; b1->b2 [label="easy"]; b1->b3 [label="other"]
  }
  subgraph cluster_c { label="Parallelization (sectioning or voting)"; fontsize=12; style="rounded"; color="#9CA3AF"
    c0 [label="Input", fillcolor="white", color="#6B7280"]
    c1 [label="LLM 1"]; c2 [label="LLM 2"]; c3 [label="LLM 3"]
    c4 [label="Aggregate\n(code)", fillcolor="#DCFCE7", color="#16A34A"]
    c0->c1; c0->c2; c0->c3; c1->c4; c2->c4; c3->c4
  }
  subgraph cluster_d { label="Orchestrator-workers"; fontsize=12; style="rounded"; color="#9CA3AF"
    d0 [label="Input", fillcolor="white", color="#6B7280"]
    d1 [label="Orchestrator\nLLM"]
    d2 [label="Worker 1"]; d3 [label="Worker 2"]
    d4 [label="Synthesize"]
    d0->d1; d1->d2 [label="subtasks set\nat runtime"]; d1->d3; d2->d4; d3->d4
  }
  subgraph cluster_e { label="Evaluator-optimizer"; fontsize=12; style="rounded"; color="#9CA3AF"
    e0 [label="Input", fillcolor="white", color="#6B7280"]
    e1 [label="Generator\nLLM"]
    e2 [label="Evaluator\nLLM"]
    e3 [label="Output", fillcolor="white", color="#6B7280"]
    e0->e1; e1->e2; e2:s -> e3:n [label="accept"]; e2:e -> e1:e [label="feedback", constraint=false]
  }

  r0 [style=invis, shape=point, width=0.01, label=""]
  r0 -> a0 [style=invis, weight=20]
  r0 -> b0 [style=invis, weight=20]
  r0 -> c0 [style=invis, weight=20]
  a4 -> d0 [style=invis]
  a4 -> e0 [style=invis]
}
