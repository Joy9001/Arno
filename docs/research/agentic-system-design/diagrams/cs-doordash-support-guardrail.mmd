%%{init: {"theme":"base","themeVariables":{"fontFamily":"Helvetica, Arial, sans-serif","fontSize":"14px","lineColor":"#555555","background":"#ffffff"}}}%%
flowchart TD
  C([Multi-turn Dasher conversation]):::ext
  COND["Condense to one core issue"]:::llm
  KB[("Resolved cases mapped to<br/>knowledge-base articles")]:::store
  GEN["Generate response"]:::llm
  T1{"Tier 1: semantic similarity<br/>response vs article segments<br/>(cheap)"}:::code
  T2{"Tier 2: LLM groundedness<br/>evaluator (only if tier 1 flags)"}:::llm
  SHOW([Response shown to Dasher]):::code
  HUM["Human agent<br/>failure default"]:::human
  subgraph OFF ["Offline monitoring"]
    direction TB
    J["LLM judge: retrieval correctness,<br/>accuracy, grammar, coherence, relevance"]:::llm
    P["Promptfoo regression suites<br/>block deploy on failure"]:::code
    H["Humans calibrate against judge"]:::human
  end

  C --> COND
  COND -->|core issue| KB
  KB -->|retrieved cases and articles| GEN
  GEN --> T1
  T1 -->|passes| SHOW
  T1 -->|flagged| T2
  T2 -->|grounded| SHOW
  T2 -->|fails| HUM
  GEN -.->|sampled responses| J
  H -.-> J
  P -.->|every prompt change| GEN
