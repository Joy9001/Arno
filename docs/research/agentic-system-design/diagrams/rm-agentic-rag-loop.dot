digraph agentic {
  graph [rankdir=TB, fontname="Helvetica", bgcolor=white, label="Agentic RAG: the model runs the retrieval loop", labelloc=t, fontsize=16, nodesep=0.4, ranksep=0.45, pad=0.2]
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, penwidth=1.5, color="#2563EB", fillcolor="#DBEAFE", margin="0.12,0.07"]
  edge [color="#555555", fontname="Helvetica", fontsize=11, penwidth=1.3]

  q [label="user query\n(multi-hop, ambiguous or under-specified)", color="#6B7280", fillcolor="#FFFFFF"]
  d1 [label="Whether?\nretrieve at all, or answer\nfrom parametric knowledge", shape=diamond, style=filled, margin="0.02,0.02"]
  plan [label="What? Plan / decompose\nthe query into sub-queries"]
  sel [label="Where? Select a retrieval tool"]
  subgraph cluster_tools {
    label="retrieval tools"; style="rounded,dashed"; color="#7C3AED"; fontsize=12; fontname="Helvetica"
    node [color="#7C3AED", fillcolor="#EDE9FE"]
    t1 [label="vector"]; t2 [label="SQL"]; t3 [label="web"]; t4 [label="grep"]
    {rank=same; t1; t2; t3; t4}
  }
  grade [label="Reflect: critic / grader\nscores the retrieved evidence"]
  d2 [label="Good\nenough?", shape=diamond, style=filled, margin="0.02,0.02"]
  gen [label="generate answer\nfrom retrieved evidence"]
  direct [label="answer directly"]
  risk [label="Costs of the loop: unbounded cost and latency,\lerror compounding, harder to evaluate,\lnew attack surface\l", shape=note, color="#DC2626", fillcolor="#FEE2E2", fontsize=11]

  q -> d1
  d1 -> direct [label="  no"]
  d1 -> plan [label="  yes"]
  plan -> sel
  sel -> t1; sel -> t2; sel -> t3; sel -> t4
  t1 -> grade; t2 -> grade; t3 -> grade; t4 -> grade
  grade -> d2
  d2 -> gen [label="  yes"]
  d2 -> plan [label="  no: rewrite query,\l  re-retrieve or switch tool\l", constraint=false, style=dashed, color="#2563EB", fontcolor="#2563EB"]
  gen -> risk [style=invis]
}
