%%{init: {"theme":"base","themeVariables":{"fontFamily":"Helvetica, Arial, sans-serif","fontSize":"14px","lineColor":"#555555","background":"#ffffff"}}}%%
flowchart TD
  Q([User research query]):::ext
  LEAD["Lead agent (Opus 4)<br/>plans, synthesizes, can spawn more"]:::llm
  MEM[("External memory<br/>saved plan (context past<br/>200K tokens is truncated)")]:::store
  RULES["Effort-scaling rules in prompt<br/>1 agent / 3-10 calls for facts,<br/>10+ subagents for complex work"]:::code
  subgraph PAR ["3-5 parallel subagents (Sonnet 4)"]
    direction LR
    S1["Subagent<br/>own context,<br/>tools, prompt"]:::llm
    S2["Subagent<br/>own context,<br/>tools, prompt"]:::llm
    S3["Subagent<br/>own context,<br/>tools, prompt"]:::llm
  end
  STORE[("External storage<br/>large outputs")]:::store
  CIT["Citation agent<br/>attaches claims to sources"]:::llm
  OUT([Final answer with citations]):::code

  Q --> LEAD
  RULES -.->|bounds spawning| LEAD
  LEAD -->|saves plan| MEM
  LEAD -->|spawns, waits for each batch| PAR
  PAR -->|write large outputs| STORE
  STORE -->|lightweight references<br/>avoid telephone-game loss| LEAD
  LEAD -->|synthesized report| CIT
  CIT --> OUT
