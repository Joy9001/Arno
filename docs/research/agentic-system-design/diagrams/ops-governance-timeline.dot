digraph timeline {
  graph [rankdir=TB, fontname="Helvetica", fontsize=18, bgcolor=white, label="EU AI Act and NIST milestones, as of 2026-10-18", labelloc=t, nodesep=0.3, ranksep=0.22, newrank=true];
  node [fontname="Helvetica", fontsize=12];
  edge [color="#555555", arrowhead=none, penwidth=1.5];

  node [shape=box, style="filled,rounded", fillcolor="#F3F4F6", color="#6B7280", fontcolor="#111111", margin="0.14,0.06", width=1.25];
  d1 [label="2025-08-02"]; d2 [label="2026-02-17"]; d3 [label="2026-07-27"]; d4 [label="2026-08-02"];
  now [label="Read date 2026-10-18", shape=box, style="filled", fillcolor="#FFFFFF", color="#111111", fontcolor="#111111", width=2.2];
  d5 [label="2026-12-02", style="dashed,rounded,filled", fillcolor="#FFFFFF"];
  d6 [label="2027-08-02", style="dashed,rounded,filled", fillcolor="#FFFFFF"];
  d7 [label="2027-12-02", style="dashed,rounded,filled", fillcolor="#FFFFFF"];
  d8 [label="2028-08-02", style="dashed,rounded,filled", fillcolor="#FFFFFF"];
  d1 -> d2 -> d3 -> d4 -> now -> d5 -> d6 -> d7 -> d8;

  node [shape=box, style="filled,rounded", margin="0.14,0.07", width=0, fontcolor="#111111"];
  e1 [label="GPAI model obligations already apply (Arts. 51-56);\nunchanged by the omnibus", fillcolor="#DCFCE7", color="#16A34A"];
  e2 [label="NIST CAISI launches AI Agent Standards Initiative\n(no agent-specific standard final yet)", fillcolor="#DBEAFE", color="#2563EB"];
  e3 [label="Digital Omnibus on AI in force\n(secondary sources; Official Journal text not checked)", fillcolor="#DCFCE7", color="#16A34A"];
  e4 [label="Article 50 transparency obligations apply\n(disclosure when interacting with AI)", fillcolor="#DCFCE7", color="#16A34A"];
  e5 [label="Art. 50(2) machine-readable marking grace period ends\nfor systems already on market", fillcolor="#FFFFFF", color="#16A34A", style="dashed,rounded,filled"];
  e6 [label="Member States must have AI regulatory sandboxes", fillcolor="#FFFFFF", color="#16A34A", style="dashed,rounded,filled"];
  e7 [label="High-risk obligations: standalone Annex III systems\n(pushed from 2026-08-02)", fillcolor="#FFFFFF", color="#16A34A", style="dashed,rounded,filled"];
  e8 [label="High-risk obligations: AI embedded in Annex I products\n(pushed from 2027-08-02)", fillcolor="#FFFFFF", color="#16A34A", style="dashed,rounded,filled"];

  edge [style=dotted, color="#9CA3AF"];
  {rank=same; d1 -> e1}
  {rank=same; d2 -> e2 [color="#2563EB"]}
  {rank=same; d3 -> e3}
  {rank=same; d4 -> e4}
  {rank=same; d5 -> e5}
  {rank=same; d6 -> e6}
  {rank=same; d7 -> e7}
  {rank=same; d8 -> e8}

  leg [shape=plaintext, style="", fontsize=11, label="Solid: already in effect or happened at the read date.  Dashed: still ahead.\nGreen: EU AI Act / omnibus.  Blue: NIST.  Dates are as stated in the survey."];
  d8 -> leg [style=invis];
}
