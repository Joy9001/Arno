digraph G {
  graph [rankdir=TB, fontname="Helvetica", bgcolor=white, label="Who controls the next step: code or model?\n(patterns ordered least to most autonomous)", labelloc=t, fontsize=16, nodesep=0.3, ranksep=0.35, pad=0.2, compound=true]
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.18,0.1"]
  edge [color="#555555", fontname="Helvetica", fontsize=10, arrowsize=0.8]

  direct [label="Direct model call\n(lowest complexity level, Microsoft)", fillcolor="#DBEAFE", color="#2563EB"]

  subgraph cluster_wf {
    label=""
    style="rounded,filled"; fillcolor="#F0FDF4"; color="#16A34A"; fontsize=11; labeljust=l
    chain [label="Controlled flows\n(prompt chaining / sequential)", fillcolor="#DCFCE7", color="#16A34A"]
    rp [label="Routing and parallelization", fillcolor="#DCFCE7", color="#16A34A"]
    wfnote [shape=plaintext, style="", fontsize=11, label=<<b>WORKFLOW</b><br/>LLMs and tools run through<br/>predefined code paths:<br/>code decides the next step>]
    {rank=same; rp; wfnote}
    rp -> wfnote [style=invis]
    refl [label="Reflect / critique\n(evaluator-optimizer)\nand human-in-the-loop", fillcolor="#DCFCE7", color="#16A34A"]
  }

  subgraph cluster_ag {
    label=""
    style="rounded,filled"; fillcolor="#EFF6FF"; color="#2563EB"; fontsize=11; labeljust=l
    single [label="Single agent\n(LLM + tools + environment feedback in a loop)", fillcolor="#DBEAFE", color="#2563EB"]
    multi [label="Multi-agent systems", fillcolor="#DBEAFE", color="#2563EB"]
    agnote [shape=plaintext, style="", fontsize=11, label=<<b>AGENT</b><br/>LLM directs its own process<br/>and tool usage:<br/>model decides the next step>]
    {rank=same; multi; agnote}
    multi -> agnote [style=invis]
  }

  direct -> chain [label=" add fixed steps"]
  chain -> rp [label=" add branching"]
  rp -> refl [label=" add loops / checkpoints"]
  refl -> single [label=" hand control of the loop to the model"]
  single -> multi [label=" delegate to other agents"]

  note [shape=note, style=filled, fillcolor="#F3F4F6", color="#6B7280", fontsize=10, label="MongoDB: fully autonomous multi-agent workflows mean\n\"higher costs, latency, and a system that is hard to debug.\"\nMicrosoft: use the lowest level of complexity\nthat reliably meets your requirements."]
  multi -> note [style=dashed, arrowhead=none, color="#6B7280"]
}
