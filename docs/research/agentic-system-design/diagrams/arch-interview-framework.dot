digraph G {
  rankdir=TB; bgcolor=white; nodesep=0.3; ranksep=0.32; compound=true;
  fontname="Helvetica"; labelloc=t; fontsize=20;
  label="Merged interview template for a GenAI system-design question\n(synthesis of the published frameworks)\n ";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.16,0.09", penwidth=1.5, fillcolor="#DCFCE7", color="#16A34A", width=5.6];
  edge [color="#555555", fontname="Helvetica", fontsize=11, fontcolor="#333333", arrowsize=0.8];

  subgraph cluster_a { label="Frame"; fontname="Helvetica-Bold"; fontsize=13; style="rounded,dashed"; color="#6B7280";
    S1 [label="1. Clarify\nuser, task, autonomy level, success metric, latency class,\nscale, data sensitivity, error tolerance, write-action risk"];
    S2 [label="2. Estimate\nDAU -> tokens/sec (input and output separately) -> GPUs / cost;\nstate assumptions aloud"];
  }
  subgraph cluster_b { label="Design"; fontname="Helvetica-Bold"; fontsize=13; style="rounded,dashed"; color="#6B7280";
    S3 [label="3. Sketch\nthe request-path pipeline; mark which boxes are in scope"];
    S4 [label="4. Deep dive where probed\nretrieval, serving, agent loop, or safety"];
    S5 [label="5. Trade-offs\nat least one table-style comparison per major decision"];
  }
  subgraph cluster_c { label="Close"; fontname="Helvetica-Bold"; fontsize=13; style="rounded,dashed"; color="#6B7280";
    S6 [label="6. Failure, ops, evals\ntop failure modes; metrics (TTFT / TPOT / P95, grounding rate,\ntask success); fallbacks"];
    S7 [label="7. Evolve\nv1 -> v2: distillation, routing, personalization,\noffline jobs, A/B, feedback loop"];
  }
  S1 -> S2 [label="  requirements fix the load"];
  S2 -> S3 [label="  numbers size the components"];
  S3 -> S4 [label="  interviewer picks a box"];
  S4 -> S5;
  S5 -> S6;
  S6 -> S7;

  SRC [label="What interviewers say they grade: LLM awareness (tokens, context limits),\nmodular thinking, cost-consciousness, safety and governance, communication;\nagentic questions: balance of autonomy and control", shape=note, fillcolor="white", color="#6B7280", style="filled", width=5.6, fontsize=11];
  S7 -> SRC [style=dashed, arrowhead=none];
}
