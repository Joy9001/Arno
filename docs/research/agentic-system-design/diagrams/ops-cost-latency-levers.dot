digraph levers {
  graph [rankdir=TB, fontname="Helvetica", fontsize=18, bgcolor=white, label="Cost and latency levers on the agent request path", labelloc=t, nodesep=0.3, ranksep=0.38];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.14,0.08", fillcolor="#DCFCE7", color="#16A34A"];
  edge [color="#555555", fontname="Helvetica", fontsize=11, fontcolor="#333333"];

  REQ [label="Incoming request or loop turn"];
  BATCH [label="Offline work (evals, backfills)\nBatch API: 50% discount,\nmost batches under 1 hour", fillcolor="#F3F4F6", color="#6B7280", style="rounded,filled,dashed"];
  SEM [label="Semantic cache\nlooser threshold: more hits,\nmore wrong answers", fillcolor="#F3F4F6", color="#6B7280"];
  HIT [label="Return cached answer\nrisk: stale plan on\na tool-calling turn", fillcolor="#FEE2E2", color="#DC2626"];
  GR [label="Input guardrail\nparallel: lower latency, but side\neffects may already have run\nblocking: no wasted side effects,\nadds latency"];
  BUD [label="Budget gate + circuit breaker\nchecked BEFORE each model call\ntokens, dollars, steps,\nconsecutive errors, elapsed time"];
  STOP [label="Stop the loop\n(e.g. hard cap of\n8 model calls)", fillcolor="#FEE2E2", color="#DC2626"];
  ROUTE [label="Router or cascade\ncheap model first, strong model\nwhen needed (RouteLLM, FrugalGPT)"];
  PC [label="Prompt cache (provider prefix)\nstable prefix: reads about 0.1x\nbase input; a timestamp in an\nearly block defeats it", fillcolor="#F3F4F6", color="#6B7280"];
  LLM [label="Model call", fillcolor="#DBEAFE", color="#2563EB"];
  TOOLS [label="Independent tool calls in parallel\n(LLMCompiler: up to 3.7x latency\nspeedup, 6.7x cost saving)", fillcolor="#EDE9FE", color="#7C3AED"];
  OUT [label="Final answer"];

  REQ -> SEM;
  REQ -> BATCH [style=dashed, label="  not interactive"];
  SEM -> HIT [label="  hit"];
  SEM -> GR [label="  miss"];
  GR -> BUD;
  BUD -> STOP [label="  limit"];
  BUD -> ROUTE [label="  within budget"];
  ROUTE -> PC;
  PC -> LLM;
  LLM -> OUT [label="  done"];
  LLM -> TOOLS [label="  tool requests"];
  TOOLS -> BUD [label="  next turn", constraint=false];
  {rank=same; REQ; BATCH}
  {rank=same; SEM}
  {rank=same; BUD; STOP}
  {rank=same; LLM; OUT}
}
