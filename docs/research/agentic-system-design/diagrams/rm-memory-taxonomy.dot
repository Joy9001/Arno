digraph memory {
  graph [rankdir=TB, fontname="Helvetica", bgcolor=white, label="Agent memory: CoALA taxonomy and four implementation families", labelloc=t, fontsize=16, nodesep=0.25, ranksep=0.5, pad=0.2, compound=true, newrank=true]
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, penwidth=1.5, color="#6B7280", fillcolor="#F3F4F6", margin="0.1,0.07"]
  edge [color="#555555", fontname="Helvetica", fontsize=11, penwidth=1.3]

  subgraph cluster_tax {
    label="Taxonomy (CoALA, Sumers et al.)"; style="rounded"; color="#2563EB"; fontsize=13; fontname="Helvetica-Bold"
    wm [label="WORKING memory\ncurrent task state\ncontext window, scratchpad\nalways in prompt", color="#2563EB", fillcolor="#DBEAFE"]
    subgraph cluster_lt {
      label="LONG-TERM memory"; style="rounded,dashed"; color="#6B7280"; fontsize=12; fontname="Helvetica"
      ep [label="EPISODIC\npast interactions,\ntrajectories\nsimilarity + recency search", shape=cylinder]
      sem [label="SEMANTIC\nfacts about user / world\nprofile or fact collection,\nknowledge graph", shape=cylinder]
      proc [label="PROCEDURAL\nhow to behave\nsystem-prompt rules, skills", shape=cylinder]
      {rank=same; ep; sem; proc}
    }
    wm -> ep [label="  write / read", dir=both, ltail=cluster_lt, style=invis]
    wm -> sem [dir=both, label="  retrieval in,\l  extraction + update out\l", lhead=cluster_lt]
  }

  subgraph cluster_impl {
    label="Implementation families (no settled architecture)"; style="rounded"; color="#16A34A"; fontsize=13; fontname="Helvetica-Bold"
    node [fillcolor="#FFFFFF"]
    f1 [label="1. Fact store\nMem0: extract facts per turn, LLM picks\nADD / UPDATE / DELETE / NOOP\nvector (+ graph) retrieval", color="#16A34A"]
    f2 [label="2. Temporal knowledge graph\nZep / Graphiti: episodes become entities\nand facts with validity windows;\ninvalidated, not deleted", color="#16A34A"]
    f3 [label="3. OS-style tiers\nMemGPT / Letta: the LLM edits its own\ncore blocks, recall log, archival store\nvia function calls", color="#2563EB", fillcolor="#DBEAFE"]
    f4 [label="4. Files\nAnthropic memory tool, Claude Code MEMORY.md:\nmodel views / creates / edits a /memories\ndirectory (client-side)", color="#2563EB", fillcolor="#DBEAFE"]
    f1 -> f2 -> f3 -> f4 [style=invis]
  }
  sem -> f1 [ltail=cluster_lt, lhead=cluster_impl, label="  implemented by", style=dashed]
  note [shape=note, color="#6B7280", fillcolor="#F9FAFB", label="Green: fixed pipeline decides what to store.\lBlue: the agent decides what to store.\l", fontsize=10]
  f4 -> note [style=invis]
}
