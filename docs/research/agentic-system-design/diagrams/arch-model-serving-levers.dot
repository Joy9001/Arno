digraph G {
  rankdir=TB; bgcolor=white; nodesep=0.45; ranksep=0.4; compound=true;
  fontname="Helvetica"; labelloc=t; fontsize=20;
  label="Model serving: managed API vs self-hosted pool, and the levers inside it\n ";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.14,0.08", penwidth=1.5];
  edge [color="#555555", fontname="Helvetica", fontsize=11, fontcolor="#333333", arrowsize=0.8];

  LG [label="LLM gateway\nroutes by tier, privacy, fallback", fillcolor="#DCFCE7", color="#16A34A"];
  MA [label="Managed API\nper-token price, shipped in hours;\nprovider queues, rate limits;\ndata leaves your boundary", fillcolor="#EDE9FE", color="#7C3AED"];
  { rank=same; LG; MA; }
  LG -> MA [label=" managed route"];

  subgraph cluster_sh {
    label="Self-hosted pool (vLLM / TGI / TensorRT-LLM on GPUs)\nyou control batching, placement, quantization, speculative decoding";
    fontsize=12; fontname="Helvetica-Bold"; style="rounded,dashed"; color="#2563EB";

    Q  [label="Request queue\n(queueing counts toward TTFT)", fillcolor="#DCFCE7", color="#16A34A"];
    P  [label="Prefill\nall input tokens in parallel;\ncompute-bound: sets TTFT", fillcolor="#DBEAFE", color="#2563EB"];
    KV [label="KV cache (GPU memory)\ngrows with batch x sequence length\nLlama 2 7B, 4,096 tokens, FP16: ~2 GB", shape=cylinder, fillcolor="#F3F4F6", color="#6B7280"];
    D  [label="Decode\none token per step;\nmemory-bandwidth-bound: sets TPOT", fillcolor="#DBEAFE", color="#2563EB"];

    L1 [label="Lever: continuous batching\nfinished sequences leave, new ones\njoin each iteration", fillcolor="#DCFCE7", color="#16A34A", style="rounded,filled,dashed"];
    L2 [label="Lever: PagedAttention, GQA / MQA\nblock-allocated KV cache, fewer\nKV heads: bigger batches fit", fillcolor="#DCFCE7", color="#16A34A", style="rounded,filled,dashed"];
    L3 [label="Lever: quantization\nlower-precision weights: fit larger\nmodels, less to read per token", fillcolor="#DCFCE7", color="#16A34A", style="rounded,filled,dashed"];
    L4 [label="Lever: speculative decoding\ndraft proposes k tokens, target\nverifies in one pass", fillcolor="#DCFCE7", color="#16A34A", style="rounded,filled,dashed"];

    Q -> P [label="  admitted to batch"];
    P -> KV [label="  writes keys / values"];
    KV -> D [label="  read + append\n  each step"];
    { rank=same; Q; L1; }
    { rank=same; KV; L2; }
    { rank=same; D; L3; }
    L1 -> Q [style=dotted, arrowhead=none];
    L2 -> KV [style=dotted, arrowhead=none];
    L3 -> D [style=dotted, arrowhead=none];
    D -> L4 [style=dotted, arrowhead=none, dir=none];
  }

  OUT [label="Streamed tokens to client\n(from either route)", fillcolor="#EDE9FE", color="#7C3AED"];
  NOTE [label="Caveats: speculative-decoding gains shrink as batch size grows;\nvLLM favors throughput, TGI showed lower tail latency\nat single-user concurrency (arXiv, Nov 2025)", shape=note, fillcolor="white", color="#6B7280", style="filled", fontsize=11];

  LG -> Q [label="  self-hosted route", lhead=cluster_sh];
  D -> OUT [ltail=cluster_sh];
  MA -> OUT [style=invis];
  OUT -> NOTE [style=invis];
}
