digraph G {
  rankdir=TB; newrank=true; bgcolor=white; nodesep=0.4; ranksep=0.6; compound=true;
  label="Protocol layering: A2A between agents, MCP below to tools"; labelloc=t; fontsize=18; fontname="Helvetica-Bold";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, fillcolor="#DBEAFE", color="#2563EB", penwidth=1.5];
  edge [color="#555555", fontname="Helvetica", fontsize=10, arrowsize=0.7];

  a [label="Agent A\n(team / vendor A)"];
  b [label="Agent B (team / vendor B)\npublishes an Agent Card"];
  proto [label="A2A
task lifecycle,
messages, artifacts", shape=box, style="rounded,filled", fillcolor="#EDE9FE", color="#7C3AED", fontsize=11];
  a -> proto [dir=both, penwidth=2, color="#7C3AED"]; proto -> b [dir=both, penwidth=2, color="#7C3AED"];
  {rank=same; a; proto; b}

  ta [label="Tools / data / prompts\n(MCP servers)", fillcolor="#EDE9FE", color="#7C3AED"];
  tb [label="Tools / data / prompts\n(MCP servers)", fillcolor="#EDE9FE", color="#7C3AED"];
  a -> ta [weight=20, dir=both, label=" MCP\l JSON-RPC 2.0\l", penwidth=2, color="#2563EB", fontcolor="#2563EB"];
  b -> tb [weight=20, dir=both, label=" MCP\l", penwidth=2, color="#2563EB", fontcolor="#2563EB"];

  fold [shape=note, style=filled, fillcolor="#FFFBEB", color="#9CA3AF", fontsize=11,
    label="Same codebase or ownership?\nA function call, queue or HTTP API is enough.\nA2A earns its keep at real ownership / trust\nboundaries; identity, authorization, delegation\ntracking and audit across them remain unresolved."];
  status [shape=note, style=filled, fillcolor="#F3F4F6", color="#6B7280", fontsize=11,
    label="Status as of 2026-10\nMCP (Anthropic, 2024-11): Linux Foundation AAIF, 2025-12-09;\nspec 2026-07-28 is stateless\nA2A (Google, 2025-04): Linux Foundation 2025-06-23; v1.0 2026-03;\n150+ supporting orgs (logo-level counts)\nACP: merged into A2A (~2025-08-29)\nANP: little production evidence found"];
  ta -> fold [style=invis]; tb -> fold [style=invis];
  fold -> status [style=invis];
}
