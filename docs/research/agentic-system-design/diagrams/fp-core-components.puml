@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 13
skinparam ArrowColor #555555
skinparam ArrowFontSize 11
skinparam RoundCorner 14
skinparam rectangle {
  BorderThickness 1.5
}
skinparam rectangle<<llm>> {
  BackgroundColor #DBEAFE
  BorderColor #2563EB
}
skinparam rectangle<<code>> {
  BackgroundColor #DCFCE7
  BorderColor #16A34A
}
skinparam rectangle<<ext>> {
  BackgroundColor #EDE9FE
  BorderColor #7C3AED
}
skinparam rectangle<<hum>> {
  BackgroundColor #FFEDD5
  BorderColor #EA580C
}
skinparam rectangle<<orch>> {
  BackgroundColor #F0FDF4
  BorderColor #16A34A
}
skinparam database {
  BackgroundColor #F3F4F6
  BorderColor #6B7280
}
hide stereotype
title Core components of an agentic system\n(normalized across vendor lists)

rectangle "**Instructions / policy**\nprompt, goals, scope, guardrails" as instr <<llm>>
database "**Memory**\nshort-term + long-term state" as mem

rectangle "**Orchestration**\nrun loop, workflow code, exit conditions\n(final output, no tool calls, error, max turns)" as orch <<orch>> {
  rectangle "**Model**\nreasoning + planning" as model <<llm>>
  rectangle "**Guardrails, sandbox,**\nleast-privilege permissions" as guard <<code>>
  rectangle "**Tools / actions**\ndata and retrieval, action,\norchestration (agents as tools)" as tools <<ext>>
}

rectangle "**Environment**\ndata sources, APIs, code execution\n('ground truth' at each step)" as env <<ext>>
rectangle "**Human oversight**\ncheckpoints, approval, escalation" as human <<hum>>

instr -down-> model : guides
mem <-down-> model : read / write
model -down-> guard : proposed tool call
guard -down-> tools : allowed call
tools -down-> env : acts on / queries
env -[#2563EB,dashed]-> model : <color:#2563EB>results = feedback\n<color:#2563EB>for the next step
model <-right-> human : risky action:\napprove / redirect
@enduml
