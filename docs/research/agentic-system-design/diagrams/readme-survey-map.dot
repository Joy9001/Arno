digraph SurveyMap {
  graph [rankdir=TB, fontname="Helvetica", fontsize=16, labelloc=t, nodesep=0.3, ranksep=0.45,
         label=<<b>Survey map: where each file sits in an agentic system</b><br/><font point-size="11" color="#555555">Read top to bottom: vocabulary, the system's three layers, the operations wrapper around them, then evidence and tooling</font><br/> >,
         bgcolor=white, pad=0.3];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.25,0.12", width=5.6, color="#555555", fillcolor=white];
  edge  [fontname="Helvetica", fontsize=11, color="#555555", fontcolor="#333333"];

  F [label=<<b>Vocabulary &amp; patterns</b><br/>workflow vs agent · who controls the next step · pattern catalogs<br/><font color="#555555"><i>foundations-and-patterns.md</i></font>>];

  subgraph cluster_ops {
    label=<<b>Operations wrapper</b><br/><font point-size="11">durable execution · idempotency · human-in-the-loop · security · cost · telemetry · governance</font><br/><font point-size="11" color="#555555"><i>production-and-operations.md</i></font>>;
    style="rounded,filled"; color="#EA580C"; fillcolor="#FFF7ED"; fontname="Helvetica"; fontsize=13; margin=18;

    REQ [fillcolor="#DCFCE7", color="#16A34A", label=<<b>Request path</b><br/>gateway → guardrails → cache → router →<br/>context construction → model gateway → stream<br/><font color="#555555"><i>genai-system-architecture.md</i></font>>];
    AG  [fillcolor="#DBEAFE", color="#2563EB", label=<<b>Agent layer</b><br/>one agent loop, or several agents coordinated over MCP / A2A<br/><font color="#555555"><i>multi-agent-systems.md</i></font>>];
    RET [shape=cylinder, style=filled, fillcolor="#F3F4F6", color="#6B7280", label=<<b>Retrieval &amp; memory</b><br/>hybrid search · rerank · GraphRAG ·<br/>fact stores · temporal knowledge graphs · files<br/><font color="#555555"><i>retrieval-and-memory.md</i></font>>];

    REQ -> AG  [label="  hands open-ended tasks to"];
    AG  -> RET [label="  retrieves context, writes memories"];
  }

  CS [label=<<b>Evidence</b><br/>18 production systems · failures &amp; reversals<br/><font color="#555555"><i>case-studies.md</i></font>>];
  RL [label=<<b>Tooling &amp; frontier</b><br/>frameworks · managed platforms · serving research · benchmarks<br/><font color="#555555"><i>research-and-landscape.md</i></font>>];

  F   -> REQ [label="  defines the vocabulary used below"];
  RET -> CS  [label="  how real teams assembled these layers", ltail=cluster_ops];
  CS  -> RL  [label="  what they are built with, and what comes next"];
}
