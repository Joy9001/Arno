digraph G {
  rankdir=TB; bgcolor=white; nodesep=0.4; ranksep=0.42; compound=true;
  fontname="Helvetica"; labelloc=t; fontsize=20;
  label="Reference architecture (2 of 2): agent loop, output guardrails, flywheel\n ";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.14,0.08", penwidth=1.5];
  edge [color="#555555", fontname="Helvetica", fontsize=11, fontcolor="#333333", arrowsize=0.8];

  LG [label="From figure 1: LLM gateway -> model pools\n(managed API / self-hosted / specialists)", fillcolor="#DBEAFE", color="#2563EB"];

  subgraph cluster_agent {
    label="Agent loop (optional)"; fontsize=13; fontname="Helvetica-Bold";
    style="rounded,dashed"; color="#2563EB";
    A1 [label="Model decides next action", fillcolor="#DBEAFE", color="#2563EB"];
    A2 [label="Tool executor\nvalidated, sandboxed, permissioned", fillcolor="#DCFCE7", color="#16A34A"];
    TR [label="Read tools\nsearch, SQL, RAG", fillcolor="#EDE9FE", color="#7C3AED"];
    HA [label="Human approval", fillcolor="#FFEDD5", color="#EA580C"];
    TW [label="Write tools\nemail, order, DB write", fillcolor="#EDE9FE", color="#7C3AED"];
    A1 -> A2 [label="  tool call"];
    A2 -> TR [label=" read"];
    A2 -> HA [label=" write"];
    HA -> TW [label=" approved"];
    TR -> A1 [style=dashed, constraint=false, label="observations "];
    TW -> A1 [style=dashed, constraint=false, label="observations "];
    { rank=same; TR; HA; }
  }

  OG [label="Output guardrails\nformat validator, toxicity, grounding check, PII", fillcolor="#DCFCE7", color="#16A34A"];
  FB1 [label="Retry / fallback model\n(re-enter LLM gateway)", fillcolor="#FEE2E2", color="#DC2626"];
  FB2 [label="Human handoff", fillcolor="#FFEDD5", color="#EA580C"];
  PP [label="Post-process, citations, stream to client,\npersist, emit trace + metrics", fillcolor="#DCFCE7", color="#16A34A"];
  CL [label="Client\n(receives streamed tokens)", fillcolor="#EDE9FE", color="#7C3AED"];
  FW [label="Data flywheel\nthumbs, edits, logs", shape=cylinder, fillcolor="#F3F4F6", color="#6B7280"];
  EV [label="Eval sets, fine-tuning,\nprompt fixes", fillcolor="#DCFCE7", color="#16A34A"];
  { rank=same; FB1; FB2; }
  { rank=same; CL; FW; }

  LG -> A1 [label="  completion"];
  A1 -> OG [label="  draft answer", constraint=false];
  TW -> OG [style=invis]; TR -> OG [style=invis];
  OG -> FB1 [label=" fail", color="#DC2626", fontcolor="#DC2626"];
  OG -> FB2 [label=" fail", color="#DC2626", fontcolor="#DC2626"];
  OG -> PP [label="  pass"];
  PP -> CL [label=" tokens (SSE / WebSocket)"];
  PP -> FW [label=" feedback + logs", style=dashed];
  FW -> EV;
}
