diff --git a/js/app/src/components/trace/costStatus.ts b/js/app/src/components/trace/costStatus.ts
new file mode 100644
index 0000000..c5281e3
--- /dev/null
+++ b/js/app/src/components/trace/costStatus.ts
@@ -0,0 +1,124 @@
+/**
+ * How complete a cost total is, and what to say beside it.
+ *
+ * A dollar total alone cannot tell a measured zero from an unknown price or a
+ * complete total from a subtotal. The cost summary counts the calls in each
+ * state; this turns them into one label for the inline total and one sentence
+ * for its tooltip.
+ */
+
+export type CostStatusKind = "known" | "partial" | "unknown";
+
+export interface CostStatusCounts {
+  /** Calls with a known amount, including measured zeros and subtotals. */
+  costedCount?: number | null;
+  /** Calls with no usable price. */
+  unpricedCount?: number | null;
+  /** Calls priced from a partial observation. */
+  partialCount?: number | null;
+}
+
+export interface CostStatus {
+  kind: CostStatusKind;
+  /** Short text beside the total; empty when the total needs no qualifier. */
+  label: string;
+  /** Full sentence for a tooltip; empty when the total needs no qualifier. */
+  description: string;
+  costedCount: number;
+  unpricedCount: number;
+  partialCount: number;
+}
+
+function plural(count: number, noun: string) {
+  return `${count} ${noun}${count === 1 ? "" : "s"}`;
+}
+
+/**
+ * Classifies a cost summary.
+ *
+ * Unknown means no call had a known amount, so the zero in the summary is an
+ * absence of data rather than a measured zero. Partial covers both an unpriced
+ * call beside priced ones and a subtotal that omits part of its own usage.
+ *
+ * @param counts - The summary's call counts; omitted for instrumentations that
+ *   supply neither, which read as a plain known total.
+ * @returns The kind, its short label, and a description of what is missing.
+ */
+export function getCostStatus(counts: CostStatusCounts): CostStatus {
+  const costedCount = counts.costedCount ?? 0;
+  const unpricedCount = counts.unpricedCount ?? 0;
+  const partialCount = counts.partialCount ?? 0;
+  const missing = [
+    unpricedCount > 0 ? `${plural(unpricedCount, "call")} unpriced` : null,
+    partialCount > 0
+      ? `${plural(partialCount, "call")} priced from a partial observation`
+      : null,
+  ].filter((part): part is string => part !== null);
+  if (costedCount === 0 && unpricedCount > 0) {
+    return {
+      kind: "unknown",
+      label: "unknown",
+      description: `Cost unknown: ${missing.join("; ")}.`,
+      costedCount,
+      unpricedCount,
+      partialCount,
+    };
+  }
+  if (missing.length > 0) {
+    return {
+      kind: "partial",
+      label: "partial",
+      description: `Cost is a subtotal: ${missing.join("; ")}.`,
+      costedCount,
+      unpricedCount,
+      partialCount,
+    };
+  }
+  return {
+    kind: "known",
+    label: "",
+    description: "",
+    costedCount,
+    unpricedCount,
+    partialCount,
+  };
+}
+
+/**
+ * A supplied observation's provenance for a tooltip, e.g.
+ * "reported charge · genai-prices 2.58.0 · go".
+ *
+ * An estimate is labeled as one: the amount is a list-price equivalent, not a
+ * charge the provider made. Sources are the pricing sources an attempt span
+ * declares; an unfamiliar value is shown as-is rather than guessed at.
+ */
+export function getCostProvenance({
+  source,
+  priceRevision,
+  billingSource,
+}: {
+  source?: string | null;
+  priceRevision?: string | null;
+  billingSource?: string | null;
+}): string | null {
+  const sourceLabel =
+    source === "provider_reported"
+      ? "reported charge"
+      : source === "opencode_reported"
+        ? "reported charge (OpenCode)"
+        : source === "genai-prices"
+          ? "estimated list price (genai-prices)"
+          : source === "opencode_estimated"
+            ? "estimated list price (OpenCode)"
+            : source === "published_rate"
+              ? "estimated published rate"
+              : source === "local_zero"
+                ? "local model, no provider fee"
+                : source === "unknown"
+                  ? null
+                  : source;
+  const parts = [sourceLabel, priceRevision, billingSource].filter(
+    (part): part is string => !!part && part.trim().length > 0
+  );
+  return parts.length > 0 ? parts.join(" · ") : null;
+}
