+"""Cost metadata supplied on a span by the instrumented application.
+
+Stock Phoenix prices every LLM span from its own model catalog, so an
+application's own observation is ignored and an unknown price reads as a
+catalog estimate or as zero. The calculator reads this module first: one
+immutable observation per billable attempt, with an explicit completeness and
+source, and a supplied zero kept as a measured zero.
+"""
+
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional
+
+from phoenix.trace.attributes import get_attribute_value
+
+COST_TOTAL = "llm.cost.total"
+COST_PROMPT = "llm.cost.prompt"
+COST_COMPLETION = "llm.cost.completion"
+SOURCE = "arno.cost.source"
+COMPLETENESS = "arno.cost.completeness"
+PRICE_REVISION = "arno.cost.price_revision"
+BILLING_SOURCE = "arno.cost.billing_source"
+ROLE = "arno.cost.role"
+
+KNOWN = "known"
+PARTIAL = "partial"
+UNKNOWN = "unknown"
+
+# A native model span can enclose several attempts. Only the attempt spans
+# carry cost; the logical request around them and any collect/decode span are
+# excluded from cost and from the unresolved count they would otherwise add.
+ATTEMPT = "attempt"
+
+
+@dataclass(frozen=True)
+class SuppliedCost:
+    """One application-supplied observation, validated for display."""
+
+    declared: bool = False
+    total: Optional[float] = None
+    prompt: Optional[float] = None
+    completion: Optional[float] = None
+    completeness: Optional[str] = None
+    source: Optional[str] = None
+    billing_source: Optional[str] = None
+    price_revision: Optional[str] = None
+
+
+def _amount(attributes: Mapping[str, Any], key: str) -> Optional[float]:
+    """A finite, nonnegative amount; anything else is not a usable price."""
+    value = get_attribute_value(attributes, key)
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        return None
+    amount = float(value)
+    if not math.isfinite(amount) or amount < 0:
+        return None
+    return amount
+
+
+def _label(attributes: Mapping[str, Any], key: str) -> Optional[str]:
+    value = get_attribute_value(attributes, key)
+    if not isinstance(value, str) or not value.strip():
+        return None
+    return value.strip()
+
+
+def is_cost_attempt(attributes: Optional[Mapping[str, Any]]) -> bool:
+    """Whether this span is the billable attempt rather than a wrapper.
+
+    A span without a role is a plain span and may carry cost; a span whose role
+    is anything other than ``attempt`` (a logical request, a collect, a decode)
+    is never priced or counted as unpriced.
+    """
+    if not attributes:
+        return True
+    role = _label(attributes, ROLE)
+    return role is None or role == ATTEMPT
+
+
+def read_supplied_cost(attributes: Mapping[str, Any]) -> SuppliedCost:
+    """Read the supplied observation, keeping presence separate from validity."""
+    total_value = get_attribute_value(attributes, COST_TOTAL)
+    prompt_value = get_attribute_value(attributes, COST_PROMPT)
+    completion_value = get_attribute_value(attributes, COST_COMPLETION)
+    completeness = _label(attributes, COMPLETENESS)
+    if completeness not in (KNOWN, PARTIAL, UNKNOWN):
+        completeness = None
+    declared = (
+        total_value is not None
+        or prompt_value is not None
+        or completion_value is not None
+        or completeness is not None
+    )
+    return SuppliedCost(
+        declared=declared,
+        total=_amount(attributes, COST_TOTAL),
+        prompt=_amount(attributes, COST_PROMPT),
+        completion=_amount(attributes, COST_COMPLETION),
+        completeness=completeness,
+        source=_label(attributes, SOURCE),
+        billing_source=_label(attributes, BILLING_SOURCE),
+        price_revision=_label(attributes, PRICE_REVISION),
+    )
