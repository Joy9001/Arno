@@ -0,0 +1,27 @@
+"""Counts of unpriced and partially priced calls, beside their cost totals.
+
+The cost columns coalesce a missing amount to zero for arithmetic, so a summary
+needs these counts to tell a measured zero from an unknown cost and a complete
+total from a subtotal. Both are read from storage that already exists: an
+unpriced call is a ``span_costs`` row with a null total, and a partial one
+declares ``arno.cost.completeness = partial`` on its span.
+"""
+
+from typing import Any
+
+from sqlalchemy import func
+from sqlalchemy.sql.elements import ColumnElement
+
+from phoenix.db import models
+
+COMPLETENESS_PATH = ["arno", "cost", "completeness"]
+
+
+def cost_status_columns() -> tuple[ColumnElement[Any], ...]:
+    """The unpriced, costed, and partial counts for a cost aggregate."""
+    completeness = models.Span.attributes[COMPLETENESS_PATH].as_string()
+    return (
+        func.count().filter(models.SpanCost.total_cost.is_(None)).label("unpriced_count"),
+        func.count().filter(models.SpanCost.total_cost.isnot(None)).label("costed_count"),
+        func.count().filter(completeness == "partial").label("partial_count"),
+    )
